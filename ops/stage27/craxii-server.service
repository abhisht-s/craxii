[Unit]
Description=Craxii backend
Wants=network-online.target
After=network-online.target local-fs.target
RequiresMountsFor=/srv/craxii-data /var/lib/craxii /srv/craxii/workspaces /home/craxii /opt/craxii/current /etc/craxii
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=craxii-server
Group=craxii-server
WorkingDirectory=/var/lib/craxii
ExecStartPre=/usr/bin/mkdir -p /sys/fs/cgroup/system.slice/craxii-server.service/craxii-executions
ExecStart=/opt/craxii/current/craxii-server --config /etc/craxii/config.toml
LoadCredential=openai_provider:/etc/craxii/credentials/openai_provider
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
Delegate=yes
RuntimeDirectory=craxii
RuntimeDirectoryMode=0700
LimitNOFILE=65536
LimitNPROC=16384
# The backend holds provider material in memory; never make that memory a core-dump artifact.
LimitCORE=0
# The trusted backend needs only signal authority across the workstation UID boundary. The fixed
# launcher clears this capability before executing model-controlled code.
AmbientCapabilities=CAP_KILL
# A setuid-root launcher needs these three transition capabilities, but no unrelated capability is
# available to either the backend or launcher. The launcher drops the entire child bounding set.
CapabilityBoundingSet=CAP_KILL CAP_SETGID CAP_SETUID CAP_SETPCAP
# The SSM instance role belongs to host administration. Prevent the backend and every delegated
# model-workstation descendant cgroup from reaching either EC2 Instance Metadata Service address.
IPAddressDeny=169.254.169.254
IPAddressDeny=fd00:ec2::254

[Install]
WantedBy=multi-user.target
