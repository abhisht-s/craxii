{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Craxii standalone compute watchdog contract 1",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "binding",
        "drain_ms",
        "stop_ms",
        "skew_ms"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customer_id",
            "logical_agent_id",
            "installation_id",
            "generation",
            "authorization_epoch",
            "power_operation_id",
            "period_id",
            "public_key"
          ],
          "properties": {
            "customer_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "logical_agent_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "installation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "generation": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "authorization_epoch": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "power_operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "period_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "drain_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45000
        },
        "stop_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "skew_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    },
    "Bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit",
        "key_id",
        "signature"
      ],
      "properties": {
        "permit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "environment",
            "audience",
            "permit_id",
            "run_id",
            "power_operation_id",
            "period_id",
            "compute_reservation_id",
            "customer_id",
            "logical_agent_id",
            "installation_id",
            "generation",
            "authorization_epoch",
            "issued_at",
            "expires_at",
            "max_elapsed_ms",
            "permitted_scope",
            "request_digest",
            "policy_digest"
          ],
          "properties": {
            "contract_version": {
              "const": 1
            },
            "environment": {
              "const": "development"
            },
            "audience": {
              "const": "craxii.compute-watchdog"
            },
            "permit_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "power_operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "period_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "compute_reservation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "customer_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "logical_agent_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "installation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "generation": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "authorization_epoch": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "issued_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
            },
            "expires_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
            },
            "max_elapsed_ms": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "permitted_scope": {
              "const": "bootstrap_only"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
