[Unit]
Description=Craxii first boot: a fresh enrollment credential for the worker
Requires=craxii-imds-guard.service craxii-guest-bootstrap.service
After=craxii-imds-guard.service craxii-guest-bootstrap.service network-online.target
Wants=network-online.target
Before=craxii-distribution.service

# Not kept active: it runs again whenever the worker (re)starts, so the credential is always fresh.
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /opt/craxii/guest/first-boot.py credential
TimeoutStartSec=15min
UMask=0077
LimitCORE=0
StandardOutput=null
# Failure codes (never content) also reach the serial console, which only the AWS account can read: the VM has no
# login, and its journal doesn't outlive it.
StandardError=journal+console
