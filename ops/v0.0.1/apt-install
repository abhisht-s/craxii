#!/usr/bin/python3 -I
"""Installs Ubuntu packages through Craxii's package helper (decision 46): apt-install PACKAGE [PACKAGE...]

Only plain package names from Ubuntu's archive; some packages are not allowed. Installed services don't start on their
own: run the program yourself if you need it.
"""
import json
import socket
import sys

names = sys.argv[1:]
if not names or any(name.startswith('-') for name in names):
    print('usage: apt-install PACKAGE [PACKAGE...]', file=sys.stderr)
    sys.exit(2)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
    connection.settimeout(1800)
    try:
        connection.connect('/run/craxii-apt.sock')
        connection.sendall((json.dumps({'packages': names}) + '\n').encode())
        data = b''
        while len(data) < 65536:
            chunk = connection.recv(65536)
            if not chunk:
                break
            data += chunk
        answer = json.loads(data)
    except (OSError, ValueError):
        print('apt-install: the package helper is unavailable', file=sys.stderr)
        sys.exit(1)
if answer.get('result') in ('installed', 'already_installed'):
    print(f"apt-install: {answer['result'].replace('_', ' ')}: {' '.join(answer.get('packages', []))}")
    sys.exit(0)
print(f"apt-install: refused ({answer.get('code', 'unknown')})", file=sys.stderr)
sys.exit(1)
