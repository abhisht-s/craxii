#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "${script_dir}/.." && pwd)"
cd "${repository_root}"

cargo_bin_dir="${CARGO_HOME:-${HOME:?HOME must be set to locate Cargo}/.cargo}/bin"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${cargo_bin_dir}:${PATH:-}"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: mandatory executable is unavailable: $1" >&2
    exit 127
  fi
}

require_command cargo
require_command cargo-deny
require_command node
require_command npx

expected_cargo_deny_version="cargo-deny 0.20.2"
actual_cargo_deny_version="$(cargo-deny --version)"
if [[ "${actual_cargo_deny_version}" != "${expected_cargo_deny_version}" ]]; then
  echo "error: mandatory cargo-deny version is ${expected_cargo_deny_version}; found ${actual_cargo_deny_version}" >&2
  exit 1
fi

if ! cargo fmt --version >/dev/null 2>&1; then
  echo "error: mandatory Cargo subcommand is unavailable: cargo fmt" >&2
  exit 127
fi

if ! cargo clippy --version >/dev/null 2>&1; then
  echo "error: mandatory Cargo subcommand is unavailable: cargo clippy" >&2
  exit 127
fi

if ! npx --yes markdownlint-cli2@0.22.1 --version >/dev/null; then
  echo "error: mandatory tool is unavailable: markdownlint-cli2@0.22.1" >&2
  exit 127
fi

echo "Checking Rust formatting"
cargo fmt --all --check

echo "Checking Rust targets"
cargo check --locked --workspace --all-targets

echo "Linting Rust targets"
cargo clippy --locked --workspace --all-targets -- -D warnings

echo "Testing Rust workspace"
cargo test --locked --workspace --all-targets

echo "Testing Rust documentation examples"
cargo test --locked --workspace --doc

echo "Checking Rust targets with test failpoints"
cargo check --locked --workspace --all-targets --features test-failpoints

echo "Linting Rust targets with test failpoints"
cargo clippy --locked --workspace --all-targets --features test-failpoints -- -D warnings

echo "Testing Rust workspace with test failpoints"
cargo test --locked --workspace --all-targets --features test-failpoints

echo "Building standard release without default features"
cargo build --locked --release --no-default-features

echo "Checking release exclusion for test failpoints"
release_guard_output="$(mktemp -t craxii-release-failpoints.XXXXXX)"
trap 'rm -f -- "${release_guard_output}"' EXIT
if cargo check --locked --release --features test-failpoints >"${release_guard_output}" 2>&1; then
  echo "error: release build unexpectedly accepted test-failpoints" >&2
  exit 1
fi
if ! grep -Fxq 'error: test-failpoints cannot be enabled when debug assertions are disabled' "${release_guard_output}"; then
  echo "error: release test-failpoints check failed without the expected exclusion diagnostic" >&2
  sed -n '1,160p' "${release_guard_output}" >&2
  exit 1
fi
release_guard_error_lines="$(grep -Ec '^error:' "${release_guard_output}" || true)"
if [[ "${release_guard_error_lines}" != "2" ]] || grep -Eq '^error\[E[0-9]+\]' "${release_guard_output}"; then
  echo "error: release test-failpoints check had an unexpected compilation failure" >&2
  sed -n '1,160p' "${release_guard_output}" >&2
  exit 1
fi
rm -f -- "${release_guard_output}"
trap - EXIT

echo "Inspecting standard release failpoint exclusion"
node scripts/check-release-failpoints.mjs

echo "Inspecting Cargo dependency tree"
cargo tree --locked --workspace --edges normal,build,dev

echo "Checking Rust dependency advisories"
cargo deny --locked check advisories -D warnings

echo "Checking Rust dependency licenses, bans, and sources"
cargo deny --locked check licenses bans sources

echo "Checking repository invariants"
node scripts/check-repository.mjs

echo "Linting Markdown"
npx --yes markdownlint-cli2@0.22.1 '**/*.md'

echo "Checking documentation renderer syntax"
node --check docs/scripts/render-implementation-plan.mjs

if [[ "$(uname -s)" == "Darwin" ]]; then
  echo "Verifying the native Stage 21 macOS client"
  scripts/verify-stage21-macos-client
else
  echo "Stage 21 native macOS execution is not run on this non-macOS host; structural invariants were checked"
fi
