#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repository_root="$(CDPATH= cd -- "${script_dir}/.." && pwd)"
cargo_bin_dir="${CARGO_HOME:-${HOME:?HOME must be set to locate Cargo}/.cargo}/bin"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${cargo_bin_dir}:${PATH:-}"

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' 'STAGE_22_NATIVE_MACOS_CLIENT: NOT_RUN_NON_MACOS_HOST'
  exit 0
fi

for command in swift xcodebuild cargo node rg; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    printf 'error: %s is required for the Stage 22 macOS client gate\n' "${command}" >&2
    exit 127
  fi
done

cd "${repository_root}"
package_path="clients/macos/CraxiiClient"

printf '%s\n' 'Testing Stage 22 client-core and presentation semantics'
swift test --package-path "${package_path}"

printf '%s\n' 'Checking presentation purity and the local-only Swift dependency graph'
if rg -n 'import (CraxiiAppleAdapters|Security|Network|SwiftUI|AppKit)' \
  clients/macos/CraxiiClient/Sources/CraxiiPresentation; then
  printf '%s\n' 'error: CraxiiPresentation crossed a pure presentation boundary' >&2
  exit 1
fi
swift package --package-path "${package_path}" dump-package |
  node -e 'let value=""; process.stdin.on("data", part => value += part); process.stdin.on("end", () => { const manifest = JSON.parse(value); if (manifest.dependencies.length !== 0) { console.error("error: external Swift dependencies are forbidden"); process.exit(1); } });'

if rg -n --hidden --glob '!**/.build/**' --glob '*.plist' --glob '*.xcconfig' --glob '*.json' \
  '[a-f0-9]{64}' clients/macos; then
  printf '%s\n' 'error: token-shaped material exists in macOS settings, plist, or JSON' >&2
  exit 1
fi
if rg -n --hidden --glob '!**/.build/**' \
  'UserDefaults|NSAllowsArbitraryLoads|import WebKit|\bElectron\b|\bReactNative\b|\bFlutter\b' \
  clients/macos; then
  printf '%s\n' 'error: forbidden macOS persistence, ATS, or wrapper framework detected' >&2
  exit 1
fi

printf '%s\n' 'Running the Stage 22 localhost conversation integration'
probe_path="$(swift build --package-path "${package_path}" --show-bin-path)/CraxiiStage22IntegrationProbe"
if [[ ! -x "${probe_path}" ]]; then
  printf '%s\n' 'error: Stage 22 integration probe was not built by Swift package tests' >&2
  exit 1
fi
CRAXII_STAGE22_PROBE="${probe_path}" \
  cargo test --locked -p craxii-server --test stage22 \
    native_conversation_queues_reconnects_and_cancels_against_localhost_backend \
    -- --ignored --exact --test-threads=1

printf '%s\n' 'Building and testing the macOS app and store tests'
derived_data="$(mktemp -d -t craxii-stage22-derived.XXXXXX)"
cleanup() {
  if [[ -d "${derived_data:-}" && "$(basename -- "${derived_data}")" == craxii-stage22-derived.* ]]; then
    rm -rf -- "${derived_data}"
  fi
}
trap cleanup EXIT
xcodebuild \
  -project clients/macos/Craxii.xcodeproj \
  -scheme Craxii \
  -configuration Debug \
  -destination "platform=macOS,arch=$(uname -m)" \
  -derivedDataPath "${derived_data}" \
  -quiet \
  -only-testing:CraxiiTests \
  test

printf '%s\n' 'Building and inspecting the production Release app'
if xcodebuild \
  -project clients/macos/Craxii.xcodeproj \
  -scheme Craxii \
  -configuration Release \
  -destination "platform=macOS,arch=$(uname -m)" \
  -derivedDataPath "${derived_data}" \
  -showBuildSettings |
    rg -q 'SWIFT_ACTIVE_COMPILATION_CONDITIONS = .*CRAXII_UI_TEST_FIXTURES'; then
  printf '%s\n' 'error: Release enables the UI-test fixture compilation condition' >&2
  exit 1
fi
xcodebuild \
  -project clients/macos/Craxii.xcodeproj \
  -scheme Craxii \
  -configuration Release \
  -destination "platform=macOS,arch=$(uname -m)" \
  -derivedDataPath "${derived_data}" \
  -quiet \
  build
release_executable="${derived_data}/Build/Products/Release/Craxii.app/Contents/MacOS/Craxii"
if [[ ! -x "${release_executable}" ]]; then
  printf '%s\n' 'error: Release app executable was not produced' >&2
  exit 1
fi
if strings -a "${release_executable}" |
    rg -q 'CRAXII_STAGE(21|22)_UI_SMOKE|Stage 22 smoke message|configureConversationSmokeState'; then
  printf '%s\n' 'error: Release app contains the UI-test fixture trigger, payload, or installer' >&2
  exit 1
fi

printf '%s\n' 'Running the minimal macOS UI smoke'
ui_log="${derived_data}/stage22-ui-smoke.log"
if xcodebuild \
  -project clients/macos/Craxii.xcodeproj \
  -scheme Craxii \
  -configuration Debug \
  -destination "platform=macOS,arch=$(uname -m)" \
  -derivedDataPath "${derived_data}" \
  -only-testing:CraxiiUITests \
  test 2>&1 | tee "${ui_log}"; then
  printf '%s\n' 'STAGE_22_UI_SMOKE: PASSED'
elif rg -q \
    'operation never finished bootstrapping|Test crashed with signal kill before establishing connection' \
    "${ui_log}" && \
    ! rg -q 'CraxiiUITests\.swift:[0-9]+: error:' "${ui_log}"; then
  printf '%s\n' \
    'STAGE_22_UI_SMOKE: NOT_RUN_XCUI_RUNNER_BOOTSTRAP_FAILURE (no app assertion executed)'
else
  printf '%s\n' 'error: Stage 22 UI smoke failed after the XCUI runner initialized' >&2
  exit 1
fi

printf '%s\n' 'STAGE_22_NATIVE_MACOS_CLIENT: PASSED'
