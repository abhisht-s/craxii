#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v docker >/dev/null; then
  echo "error: Docker is required for the disposable Linux boundary check" >&2
  exit 1
fi

case "$(uname -m)" in
  arm64 | aarch64) default_platform=linux/arm64 ;;
  x86_64 | amd64) default_platform=linux/amd64 ;;
  *) echo "error: unsupported local architecture" >&2; exit 1 ;;
esac
platform="${CRAXII_STAGE27_DOCKER_PLATFORM:-${default_platform}}"

docker run --rm --privileged --platform "${platform}" \
  --tmpfs /tmp:rw,nosuid,nodev,size=2g \
  -e CARGO_TARGET_DIR=/craxii-target \
  -v craxii-stage27-cargo:/usr/local/cargo/registry \
  -v craxii-stage27-target:/craxii-target \
  -v "${repository_root}:/work:ro" \
  -w /work \
  rust:1.98-bookworm \
  /work/scripts/support/stage27_linux_identity.sh
